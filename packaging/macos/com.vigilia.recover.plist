<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by `vigilia install`; runs `vigilia recover` once at login.
     Kept in sync with vigilia_daemon::install::recover_plist. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.vigilia.recover</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PROGRAM__</string>
		<string>recover</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
